allow-lan: false
mode: Rule
log-level: error
external-controller: 127.0.0.1:60000
http-opts:
  timeout: 150000

proxy-providers:
  ALL-NET:
    type: http
    path: ./ProxySet/dtqy/dt_net_11bc3aaaf1c8c37d8a529252c0c0ba32.yaml
    url: "http://blue2sea.com/clash/proxies/ddb3c76ca7631abce27fdebcc2d98de3?ua=clash-verge/v2.5.1"
    interval: 150
    filter: ''
    health-check:
      enable: true
      url: https://cp.cloudflare.com/generate_204
      interval: 120

proxy-groups:
  - name: 全部节点丨blue2sea.com
    type: select
    url: https://cp.cloudflare.com/generate_204
    interval: 60
    proxies:
      - 综合AI自动
      - ChatGPT优选
      - Gemini优选
    use:
      - ALL-NET

  # 开始
  - name: 严选丨流量倍率0.3
    type: url-test
    filter: "_0.*$"
    use:
      - ALL-NET
    url: http://www.gstatic.com/generate_204
    interval: 60
    hidden: true

  - name: 精选丨流量倍率0.5
    type: url-test
    filter: "_0.*$"
    use:
      - ALL-NET
    url: http://www.gstatic.com/generate_204
    interval: 60
    hidden: true

  - name: 专线丨流量倍率2
    type: url-test
    filter: "_ad.*$"
    use:
      - ALL-NET
    url: http://www.gstatic.com/generate_204
    interval: 300
    hidden: true

  - name: 🎬 超清多媒体丨大数据加速
    type: load-balance
    proxies:
      - 严选丨流量倍率0.3
      - 精选丨流量倍率0.5
      - 专线丨流量倍率2
      - 精选丨流量倍率0.5
      - 严选丨流量倍率0.3
    strategy: round-robin
    url: http://www.gstatic.com/generate_204
    interval: 30
    hidden: true
    filter: '^(?!.*(_31)).*$'

  # 结束

  - name: 综合AI自动
    type: url-test
    url: https://cp.cloudflare.com/generate_204
    interval: 60
    use:
      - ALL-NET
    filter: '^(?!.*(HK|TW|_0)).*$'
    hidden: true

  - name: ChatGPT优选
    type: url-test
    url: https://cp.cloudflare.com/generate_204
    interval: 60
    use:
      - ALL-NET
    filter: '^(?!.*(HK|TW|_0)).*$'
    hidden: true

  - name: Gemini优选
    type: url-test
    url: https://cp.cloudflare.com/generate_204
    interval: 60
    use:
      - ALL-NET
    filter: '^(?!.*(HK|TW|_0)).*$'
    hidden: true

  - name: Netflix
    type: select
    url: https://cp.cloudflare.com/generate_204
    interval: 60
    proxies:
      - 全部节点丨blue2sea.com
    use:
      - ALL-NET
    hidden: true

  - name: PROXY
    type: url-test
    url: https://cp.cloudflare.com/generate_204
    interval: 60
    use:
      - ALL-NET
    hidden: true

